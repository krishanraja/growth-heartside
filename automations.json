{
  "_about": "Eight canonical jobs, New York time. GitHub Actions executes a persistent draft-only fallback every 15 minutes and honors these schedules with DST. Connected authoring sessions can follow the richer job prompts. No social publishing, paid generation or Control Centre integration is enabled.",
  "timezone": "America/New_York",
  "run_in": "this local project (not a new worktree), so every run shares local/ (the sync, the packs, the creative record and the creator list)",
  "access": "network on (github.com, raw.githubusercontent.com, heartside.io and the channels); the signed-in browser when available",
  "model": "default",
  "automations": [
    {
      "name": "Heartside growth: sync",
      "schedule": "RRULE:FREQ=DAILY;BYHOUR=5;BYMINUTE=45",
      "job": "jobs/sync.md",
      "prompt": "Run jobs/sync.md as AGENTS.md says."
    },
    {
      "name": "Heartside growth: numbers",
      "schedule": "RRULE:FREQ=DAILY;BYHOUR=6;BYMINUTE=0",
      "job": "jobs/numbers.md",
      "prompt": "Run jobs/numbers.md as AGENTS.md says."
    },
    {
      "name": "Heartside growth: radar",
      "schedule": "RRULE:FREQ=DAILY;BYHOUR=6;BYMINUTE=30",
      "job": "jobs/radar.md",
      "prompt": "Run jobs/radar.md as AGENTS.md says."
    },
    {
      "name": "Heartside growth: day pack",
      "schedule": "RRULE:FREQ=DAILY;BYHOUR=9;BYMINUTE=0",
      "job": "jobs/daily-pack.md",
      "prompt": "Run jobs/daily-pack.md as AGENTS.md says."
    },
    {
      "name": "Heartside growth: creators",
      "schedule": "RRULE:FREQ=WEEKLY;BYDAY=TU;BYHOUR=7;BYMINUTE=0",
      "job": "jobs/creators.md",
      "prompt": "Run jobs/creators.md as AGENTS.md says."
    },
    {
      "name": "Heartside growth: store and search",
      "schedule": "RRULE:FREQ=WEEKLY;BYDAY=SA;BYHOUR=7;BYMINUTE=0",
      "job": "jobs/store.md",
      "prompt": "Run jobs/store.md as AGENTS.md says."
    },
    {
      "name": "Heartside growth: report",
      "schedule": "RRULE:FREQ=WEEKLY;BYDAY=SU;BYHOUR=7;BYMINUTE=0",
      "job": "jobs/report.md",
      "prompt": "Run jobs/report.md as AGENTS.md says."
    },
    {
      "name": "Heartside growth: answers",
      "schedule": "RRULE:FREQ=WEEKLY;BYDAY=WE;BYHOUR=7;BYMINUTE=30",
      "job": "jobs/answers.md",
      "prompt": "Run jobs/answers.md as AGENTS.md says."
    }
  ]
}
