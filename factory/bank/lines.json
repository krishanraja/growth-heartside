   "kind": "dialogue",
   "breeds": [
    "frenchie"
   ],
   "status": "approved",
   "source": "Krish, 2026-11-02 (locked voice read)",
   "text_sha256": "069c23131d140fcc0e9c17b656183519da114441dd445d158a8a19c34a84d551"
