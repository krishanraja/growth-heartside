   "status": "approved",
   "source": "Krish, 2026-11-02 (locked voice read)",
   "text_sha256": "da329f2dff268fc973a5b9d60339741b46d2511817cfea80b5b16ef15dd6a5d3"
  },
  {
   "id": "F05.v2",
   "text": "The defendant is accused of stealing the human's spot on the couch.",
   "role": "film.F05.v2",
   "kind": "dialogue",
   "breeds": [
    "frenchie"
   ],
   "status": "approved",
