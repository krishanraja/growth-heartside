   "status": "approved",
   "source": "Krish, 2026-11-02 (locked voice read)",
   "text_sha256": "a06e16374799c4eb1201b7a6dc0cd2e0592e0a6f15f8d66b740a1048a3a126d8"
  },
  {
   "id": "F12.v3",
   "text": "Requesting backup. Backup is asleep on the couch.",
   "role": "film.F12.v3",
   "kind": "dialogue",
   "breeds": [
    "frenchie"
   ],
   "status": "approved",
   "source": "Krish, 2026-11-02 (locked voice read)",
   "text_sha256": "0fb915fb2e7d68bd94d51dbb324ba66263b694cfcaf1ead8ae6c15b39260efce"
  },
  {
   "id": "F12.v4",
   "text": "Proceeding alone.",
   "role": "film.F12.v4",
   "kind": "dialogue",
   "breeds": [
    "frenchie"
   ],
   "status": "approved",
   "source": "Krish, 2026-11-02 (locked voice read)",
   "text_sha256": "4b5a524e54e36ec3a949da6e7a983194e3507ea50bb15f3f0fe036380a7dffa2"
  },
  {
   "id": "F12.v5",
   "text": "Oh. It's me.",
   "role": "film.F12.v5",
   "kind": "dialogue",
   "breeds": [
    "frenchie"
