   "status": "approved",
   "source": "Krish, 2026-11-02 (locked voice read)",
   "text_sha256": "520dec36bdef8cfe9af5309683db45a5b849cc5969f1b76c5b6649aeb154e07a"
  },
  {
   "id": "F12.v6",
   "text": "Threat cleared. I look incredible.",
   "role": "film.F12.v6",
   "kind": "dialogue",
   "breeds": [
    "frenchie"
   ],
   "status": "approved",
   "source": "Krish, 2026-11-02 (locked voice read)",
   "text_sha256": "57cf547a71781cd842e56391c884317d82220f00ef28e7cc25752e860f4c2dfd"
  },
  {
   "id": "F03.v1",
   "text": "Listen up. At 0600 hours, the humans wake up.",
   "role": "film.F03.v1",
   "kind": "dialogue",
   "breeds": [
    "shepherd"
   ],
   "status": "approved",
   "source": "Krish, 2026-11-02 (locked voice read)",
   "text_sha256": "4717a50f8a6a32f04fef3b5ec4eaa0920d72da620c81167d6a8e9013185d8103"
  },
  {
   "id": "F03.v2",
   "text": "Before then, the gift goes under the tree.",
   "role": "film.F03.v2",
   "kind": "dialogue",
   "breeds": [
    "shepherd"
   ],
   "status": "approved",
   "source": "Krish, 2026-11-02 (locked voice read)",
   "text_sha256": "591b768558aaaecb141f282f45385461b3a2fe9656fc4dbdfda29ea1dd8b918c"
  },
  {
   "id": "F03.v3",
   "text": "The beagle is on scent. The frenchie is lookout.",
   "role": "film.F03.v3",
   "kind": "dialogue",
   "breeds": [
    "shepherd"
   ],
   "status": "approved",
   "source": "Krish, 2026-11-02 (locked voice read)",
   "text_sha256": "2f838dc7b41891aced1bc4c1c2e2f4d0286abcc8bc56196eca48f593e95d06d3"
  },
  {
   "id": "F03.v4",
   "text": "And nobody touches the cookies.",
   "role": "film.F03.v4",
   "kind": "dialogue",
   "breeds": [
    "shepherd"
   ],
   "status": "approved",
   "source": "Krish, 2026-11-02 (locked voice read)",
   "text_sha256": "d76c0769568e7fe1b9da6eb4d18ad449ebff8ef210b56f5dfb44fb559a75470c"
  },
  {
   "id": "F03.v5",
   "text": "Questions? Good.",
   "role": "film.F03.v5",
   "kind": "dialogue",
   "breeds": [
    "shepherd"
   ],
   "status": "approved",
   "source": "Krish, 2026-11-02 (locked voice read)",
   "text_sha256": "674860ee07b062b5ffdb02584cf2149ed59ecc195f8e316fbcf89a8fb5ae7ea0"
  },
  {
   "id": "F05.v1",
   "text": "Order. ORDER in the living room.",
